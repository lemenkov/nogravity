[level_1]
Name=Sector 1
Line1 =Ve al segundo punto de Nav.
Line2 =y destruye todas las minas.
Line3 =Un carguero te espera en el
Line4 =punto de Nav. 3, escóltalo 
Line5 =al punto de remolque.
Line6 =Tienen información
Line7 =importante para ti.
Line8 =Ten ciudado; esto ya no es
Line9 =un entrenamiento, estás en 
Line10=territorio enemigo.
Time=0
Bonus=2000

[level_2]
Name=Ataque sorpresa
Line1 =Atacan la base; todas las
Line2 =naves han de volver para
Line3 =protegerla.
Line4 =En tu camino, encuentras
Line5 =seis naves enemigas
Line6 =trasnportando materiales.
Line7 =Destrúyelas todas.
Time=0
Bonus=2000

[level_3]
Name=El Ajusticiador
