[level_1]
Name=Sector One
Line1 =Go to the second Nav point
Line2 =destroy all the mines.
Line3 =A cargo is waiting for you at
Line4 =Nav 3, and escort it to the
Line5 =warp point.
Line6 =They have important
Line7 =informations for you.
Line8 =Be careful, this is not a
Line9 =training any more, you are in
Line10=enemy territory.
Time=0
Bonus=2000

[level_2]
